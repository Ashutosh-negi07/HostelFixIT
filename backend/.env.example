# HostelFixIT Backend — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/hostelfixit
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_very_long_random_string_at_least_64_chars_for_hs512

# ─── Cloudinary (free tier: cloudinary.com/users/register_free) ──────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated. For production add your deployed frontend URL.
CORS_ORIGINS=http://localhost:3000

# ─── Connection Pool (optional — increase for production) ────────────────
HIKARI_MAX_POOL=25
HIKARI_MIN_IDLE=10

# ─── Debug (optional) ────────────────────────────────────────────────────
SHOW_SQL=false
