# ─── k6 Test Environment ──────────────────────────────────────────────────────
# Local PostgreSQL — zero risk to Supabase

# Database (local Homebrew PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/hostelfixit_test
DB_USERNAME=hf_test
DB_PASSWORD=hf_test_pass

# Let Hibernate CREATE tables on a fresh local DB
SPRING_JPA_HIBERNATE_DDL_AUTO=create

# Default user passwords (read by DataInitializer on startup)
ADMIN_DEFAULT_PASSWORD=Admin@123
SUPER_ADMIN_DEFAULT_PASSWORD=SuperAdmin@123

# JWT (any secret works locally)
JWT_SECRET=k6TestSecretKey12345678901234567890ABCDEF

# Cloudinary (not needed for k6 tests — complaints created without images)
CLOUDINARY_CLOUD_NAME=dummy
CLOUDINARY_API_KEY=0
CLOUDINARY_API_SECRET=dummy

# CORS
CORS_ORIGINS=http://localhost:3000

# HikariCP — more connections for stress testing
HIKARI_MAX_POOL=30
HIKARI_MIN_IDLE=5

# Logging
SHOW_SQL=false
